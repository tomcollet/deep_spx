<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Imite le contrôle que Deepchart fait avant de charger une dll d'indicateurs : liste tout ce que la dll référence
    hors d'elle-même et signale ce que la documentation interdit (réflexion, fichiers, réseau, threads, tâches,
    lock, interop, dynamic). Voir tools/DllCheck/README.md
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
