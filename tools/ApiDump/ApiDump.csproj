<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Liste ce que les dll de Deepchart exposent réellement (types, champs, propriétés, méthodes et leurs signatures).
    Utile là où la documentation se tait : membres de AggrInfo, de BookUpdate, signature de GetSeriesValueById...
    Les dll sont lues comme des fichiers (MetadataLoadContext) : rien n'est exécuté, Deepchart n'a pas besoin de tourner.

    Lancement depuis le dossier du dépôt : voir tools/ApiDump/README.md
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>
</Project>
