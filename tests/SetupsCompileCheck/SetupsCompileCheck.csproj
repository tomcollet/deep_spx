<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Verifie que l indicateur de setups (src/DeepSpxSetups, moteur compris) compile contre l'imitation de l'API Deepchart (tests/DeepchartApiStubs),
    sur une machine sans Deepchart (Linux, CI). Ne produit rien d'utilisable dans Deepchart : la dll a charger se
    construit avec src/DeepSpxSetups/DeepSpxSetups.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/DeepSpxSetups/**/*.cs" Exclude="../../src/DeepSpxSetups/obj/**;../../src/DeepSpxSetups/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DeepchartApiStubs/DeepchartApiStubs.csproj" />
  </ItemGroup>
</Project>
