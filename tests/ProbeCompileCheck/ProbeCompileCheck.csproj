<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Verifie que la sonde (src/DeepGammaProbe) compile contre l'imitation de l'API Deepchart (tests/DeepchartApiStubs),
    sur une machine sans Deepchart (Linux, CI). Ne produit rien d'utilisable dans Deepchart : la dll a charger se
    construit avec src/DeepGammaProbe/DeepGammaProbe.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/DeepGammaProbe/**/*.cs" Exclude="../../src/DeepGammaProbe/obj/**;../../src/DeepGammaProbe/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DeepchartApiStubs/DeepchartApiStubs.csproj" />
  </ItemGroup>
</Project>
