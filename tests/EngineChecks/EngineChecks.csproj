<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Scenarios synthetiques du moteur de setups (src/DeepSpxSetups/Engine, C# pur), hors de Deepchart.
    Lancement : dotnet run, option project, sur tests/EngineChecks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/DeepSpxSetups/Engine/**/*.cs" />
  </ItemGroup>
</Project>
